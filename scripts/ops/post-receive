#!/usr/bin/env bash
# Push-to-deploy hook. Install (placeholders, run from the repo root):
#   ssh <ssh-target> "git init --bare <YST_HOME>/repo.git"
#   scp scripts/ops/post-receive <ssh-target>:<YST_HOME>/repo.git/hooks/post-receive
#   ssh <ssh-target> "chmod +x <YST_HOME>/repo.git/hooks/post-receive"
#   git remote add production <ssh-target>:<YST_HOME>/repo.git
# Manual run on the server: POST_RECEIVE_FORCE=1 <YST_HOME>/repo.git/hooks/post-receive
set -eo pipefail

YST_HOME="${YST_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
GIT_DIR="$YST_HOME/repo.git"
APP_DIR="$YST_HOME/app"
ENV_FILE="$YST_HOME/config/.env"
ZEROS="0000000000000000000000000000000000000000"

run() {
  if [ -n "${POST_RECEIVE_DRY_RUN:-}" ]; then
    echo "[DRY RUN] $*"
  else
    "$@"
  fi
}

should_deploy() {
  if [ -n "${POST_RECEIVE_FORCE:-}" ] || [ -t 0 ]; then
    return 0
  fi
  local oldrev newrev refname refs=""
  while read -r oldrev newrev refname; do
    refs="$refs $refname"
    if [ "$refname" = "refs/heads/main" ] && [ "$newrev" != "$ZEROS" ]; then
      return 0
    fi
  done
  echo "==> No deploy: no update of refs/heads/main (received:${refs})"
  return 1
}

should_deploy || exit 0

lock() {
  if [ -n "${POST_RECEIVE_DRY_RUN:-}" ]; then
    echo "[DRY RUN] flock $GIT_DIR/deploy.lock"
  else
    exec 9>"$GIT_DIR/deploy.lock"
    flock 9
  fi
}

echo "==> Deploying to $APP_DIR"
lock
run mkdir -p "$APP_DIR" "$YST_HOME/state" "$YST_HOME/secrets/notebooklm"
run chmod 700 "$YST_HOME/secrets"
YST_UID="$(id -u)"
YST_GID="$(id -g)"
export YST_UID YST_GID
run git --work-tree="$APP_DIR" --git-dir="$GIT_DIR" checkout -f main
cd "$APP_DIR"
run docker compose --env-file "$ENV_FILE" up -d --build
run docker compose --env-file "$ENV_FILE" ps
run docker image prune -f --filter label=com.docker.compose.project=youtube-summary-telegram
echo "==> Deploy complete!"
